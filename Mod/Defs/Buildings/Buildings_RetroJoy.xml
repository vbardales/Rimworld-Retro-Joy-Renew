<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--============================== Armchair ==============================-->

  <ThingDef ParentName="RetroJoy_FurnitureBase">
    <defName>RetroArmchair</defName>
    <label>retro armchair</label>
    <description>A highly comfortable armchair that was banned from making jokes, however it sure feels cozy to sit on.</description>
    <graphicData>
      <texPath>Things/RetroJoy/RetroArmchair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(0.6, 0.6, 0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>7500</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <Comfort>1.0</Comfort>
    </statBases>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <socialPropernessMatters>true</socialPropernessMatters>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <colorPerStuff>
      <li>
        <stuff>Cloth</stuff>
        <color>(68,70,74)</color>
      </li>
    </colorPerStuff>
    <costStuffCount>110</costStuffCount>
    <pathCost>30</pathCost>
    <fillPercent>0.40</fillPercent>
    <defaultPlacingRot>South</defaultPlacingRot>
    <designationCategory>Furniture</designationCategory>
    <building>
      <isSittable>true</isSittable>
    </building>
  </ThingDef>

  <!--============================== Table ==============================-->

  <ThingDef ParentName="TableBase">
    <defName>RetroSmallTable</defName>
    <label>retro table (small)</label>
    <graphicData>
      <texPath>Things/RetroJoy/RetroSmallTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <MaxHitPoints>45</MaxHitPoints>
      <WorkToBuild>380</WorkToBuild>
      <Mass>2.5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <size>(1,1)</size>
    <designationCategory>Furniture</designationCategory>
    <costStuffCount>15</costStuffCount>
  </ThingDef>

  <!--============================== Rimtendo console ==============================-->

  <ThingDef ParentName="RetroJoy_BuildingBase">
    <defName>RimtendoESConsole</defName>
    <label>Rimtendo console</label>
    <description>Plays a selection of classic games on the totally non-copyright console "Rimtendo Entertainment System". Retro TV included.</description>
    <graphicData>
      <texPath>Things/RetroJoy/RimtendoES</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shadowData>
        <volume>(0.7, 0.6, 0.7)</volume>
        <offset>(0,0,-0.15)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.40</fillPercent>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>28</Mass>
      <Flammability>1.0</Flammability>
      <MarketValue>700</MarketValue>
      <JoyGainFactor>1.1</JoyGainFactor>
    </statBases>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <pathCost>70</pathCost>
    <passability>PassThroughOnly</passability>
    <defaultPlacingRot>South</defaultPlacingRot>
    <building>
      <joyKind>Gaming_Video</joyKind>
      <spawnedConceptLearnOpportunity>TVForSickPeople</spawnedConceptLearnOpportunity>
      <boughtConceptLearnOpportunity>TVForSickPeople</boughtConceptLearnOpportunity>
      <watchBuildingStandDistanceRange>2~4</watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>5</watchBuildingStandRectWidth>
      <!--
        Added in the port. All five watch-buildings in Core set this, and the console was the
        only one that did not: the field defaults to false, so its watch area ran through walls
        and pawns could play it from the next room.
      -->
      <watchBuildingInSameRoom>true</watchBuildingInSameRoom>
      <!-- Added in the port, as on all three vanilla televisions: the screen glow. -->
      <effectWatching>WatchingTelevision</effectWatching>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <tradeTags>
      <li>Television</li>
    </tradeTags>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Joy</designationCategory>
    <researchPrerequisites>
      <li>TubeTelevision</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <!--============================== Rock'em Sock'em ==============================-->

  <ThingDef ParentName="RetroJoy_FurnitureBase">
