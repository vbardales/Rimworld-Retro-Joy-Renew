<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    allowOpportunisticPrefix was added to all three in the port. It defaults to false, and every
    joy JobDef in Core sets it to true: it is what lets a pawn on their way to the table pick up
    something that is lying around and drop it in a stockpile en route.
  -->

  <JobDef>
    <defName>PlayRockemSockem</defName>
    <driverClass>JobDriver_SitFacingBuilding</driverClass>
    <reportString>playing Rock 'em Sock 'em.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>2</joyMaxParticipants>
    <joyGainRate>1.1</joyGainRate>
    <joySkill>Melee</joySkill>
    <joyXpPerTick>0.002</joyXpPerTick>
    <joyKind>Gaming_Dexterity</joyKind>
    <taleOnCompletion>PlayedGame</taleOnCompletion>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>PlayDNRandies</defName>
    <driverClass>JobDriver_PlayPoker</driverClass>
    <reportString>playing Dungeons and Randies.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>8</joyMaxParticipants>
    <joyGainRate>1.3</joyGainRate>
    <joySkill>Intellectual</joySkill>
    <joyXpPerTick>0.004</joyXpPerTick>
    <joyKind>Gaming_Cerebral</joyKind>
    <taleOnCompletion>PlayedGame</taleOnCompletion>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>PlayRimtendoES</defName>
    <driverClass>JobDriver_WatchTelevision</driverClass>
    <reportString>playing on Rimtendo console.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>8</joyMaxParticipants>
    <joyGainRate>1.35</joyGainRate>
    <joyKind>Gaming_Video</joyKind>
    <taleOnCompletion>PlayedGame</taleOnCompletion>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <!--
      As on vanilla's WatchTelevision, and for the same reason: the job can be done from bed, so
      a downed pawn should watch from where they are rather than crawl to the console. The field
      defaults to true.
    -->
    <isCrawlingIfDowned>false</isCrawlingIfDowned>
  </JobDef>

</Defs>
