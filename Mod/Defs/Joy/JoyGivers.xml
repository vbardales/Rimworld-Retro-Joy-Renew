<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    All three name their building in <thingDefs>. That is also the condition Shared Joys uses to
    accept a building as a hangout spot, so the three work with it as they stand - nothing to
    add on that side.
  -->

  <!-- Rock'em Sock'em - dexterity play, sitting at the table -->

  <JoyGiverDef>
    <defName>PlayRockemSockem</defName>
    <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
    <baseChance>1.5</baseChance>
    <thingDefs>
      <li>RockemSockemTable</li>
    </thingDefs>
    <jobDef>PlayRockemSockem</jobDef>
    <joyKind>Gaming_Dexterity</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>

  <!-- Dungeons and Randies - cerebral play, sitting at the table -->

  <JoyGiverDef>
    <defName>PlayDNRandies</defName>
    <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
    <baseChance>1.5</baseChance>
    <thingDefs>
      <li>DNRandiesTable</li>
    </thingDefs>
    <jobDef>PlayDNRandies</jobDef>
    <joyKind>Gaming_Cerebral</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>

  <!-- Rimtendo console - watched like a television, and so possible from bed -->

  <JoyGiverDef>
    <defName>PlayRimtendoES</defName>
    <giverClass>JoyGiver_WatchBuilding</giverClass>
    <baseChance>2</baseChance>
    <canDoWhileInBed>true</canDoWhileInBed>
    <thingDefs>
      <li>RimtendoESConsole</li>
    </thingDefs>
    <jobDef>PlayRimtendoES</jobDef>
    <joyKind>Gaming_Video</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>

</Defs>
